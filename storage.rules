rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Tasks and task attachments (images, voice notes, documents)
    match /tasks/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Comments attachments (images, voice notes, videos)
    match /comments/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /comments_video/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /comments_voice/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Broadcast voice and media announcements
    match /broadcasts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // User profile documents and avatars
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
