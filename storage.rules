rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Enforce path-based controls for uploads and tasks
    match /tasks/{taskId}/{allPaths=**} {
      // Only authenticated users can read task-related files
      // Writes are limited to logged-in users who upload to tasks
      allow read, write: if request.auth != null;
    }
    match /users/{userId}/{allPaths=**} {
      // Restrict users to reading and writing their own profile/private documents
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
